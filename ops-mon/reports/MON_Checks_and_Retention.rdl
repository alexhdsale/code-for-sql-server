<TablixRows><TablixRow><Height>0.22in</Height><TablixCells><TablixCell><CellContents><Textbox Name="CheckState"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Switch(First(Fields!state.Value)="ON", ChrW(10004), First(Fields!state.Value)="NA", "-", True, "")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>#1D4ED8</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>CheckState</rd:DefaultName><Style><Border><Color>#D1D5DB</Color><Style>Solid</Style></Border><BackgroundColor>=Switch(First(Fields!state.Value)="ON", "#DBEAFE", First(Fields!state.Value)="NA", "#F3F4F6", True, "#FEF3C7")</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow></TablixRows></TablixBody>
