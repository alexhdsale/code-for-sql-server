CREATE OR ALTER FUNCTION monitor.fn_HtmlEncode(@value nvarchar(max))
RETURNS nvarchar(max)
AS
BEGIN
    IF @value IS NULL RETURN N'';
    SET @value = REPLACE(@value, N'&', N'&amp;');
    SET @value = REPLACE(@value, N'<', N'&lt;');
    SET @value = REPLACE(@value, N'>', N'&gt;');
    SET @value = REPLACE(@value, N'"', N'&quot;');
    SET @value = REPLACE(@value, N'''', N'&#39;');
    RETURN @value;
END;
GO

/* ---------- Collection ---------- */

CREATE OR ALTER PROCEDURE monitor.usp_SyncDatabaseBackupPolicy
AS
BEGIN
    SET NOCOUNT ON;

    CREATE TABLE #VisibleDatabase
    (
        database_name sysname NOT NULL PRIMARY KEY,
        state_desc nvarchar(60) NOT NULL,
        recovery_model_desc nvarchar(60) NOT NULL
    );

    INSERT #VisibleDatabase(database_name, state_desc, recovery_model_desc)
    SELECT d.name COLLATE DATABASE_DEFAULT,
           d.state_desc COLLATE DATABASE_DEFAULT,
           d.recovery_model_desc COLLATE DATABASE_DEFAULT
    FROM sys.databases AS d
    WHERE d.database_id > 4
      AND d.name COLLATE DATABASE_DEFAULT <> N'rdsadmin'
      AND d.source_database_id IS NULL;

    /* Remove only monitor configuration rows no longer returned by sys.databases. */
    DELETE p
    FROM monitor.DatabaseBackupPolicy AS p
    WHERE NOT EXISTS
          (SELECT 1 FROM #VisibleDatabase AS d
           WHERE d.database_name = p.database_name);

    DELETE i
    FROM monitor.DatabaseInventory AS i
    WHERE NOT EXISTS
          (SELECT 1 FROM #VisibleDatabase AS d
           WHERE d.database_name = i.database_name);

    UPDATE i
       SET is_enabled = 1,
           is_manually_confirmed = 0,
           discovery_source = N'SYS_DATABASES',
           last_seen_utc = SYSUTCDATETIME(),
           last_visible_utc = SYSUTCDATETIME(),
           last_known_state = d.state_desc,
           last_known_recovery_model = d.recovery_model_desc,
           modified_utc = SYSUTCDATETIME()
    FROM monitor.DatabaseInventory AS i
    JOIN #VisibleDatabase AS d ON d.database_name = i.database_name;

    INSERT monitor.DatabaseInventory
        (database_name, is_enabled, is_manually_confirmed, discovery_source,
         last_seen_utc, last_visible_utc,
         last_known_state, last_known_recovery_model)
    SELECT d.database_name, 1, 0, N'SYS_DATABASES',
           SYSUTCDATETIME(), SYSUTCDATETIME(),
           d.state_desc, d.recovery_model_desc
    FROM #VisibleDatabase AS d
    WHERE NOT EXISTS
          (SELECT 1 FROM monitor.DatabaseInventory AS i
           WHERE i.database_name = d.database_name);

    INSERT monitor.DatabaseBackupPolicy
        (database_name, require_full, require_diff, require_log, notes)
    SELECT d.database_name, 1, 1,
           CASE WHEN d.recovery_model_desc = N'SIMPLE' THEN 0 ELSE 1 END,
           N'Automatically managed from sys.databases only'
    FROM #VisibleDatabase AS d
    WHERE NOT EXISTS
          (SELECT 1 FROM monitor.DatabaseBackupPolicy AS p
           WHERE p.database_name = d.database_name);
END;
