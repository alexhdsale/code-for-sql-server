/*
   One-time, idempotent reset of monitor-owned database and backup history.
   This does NOT delete msdb backupset rows, RDS backups, S3 files, or databases.
*/
IF NOT EXISTS
   (SELECT 1 FROM monitor.DeploymentState
    WHERE deployment_key = N'SYS_DATABASES_ONLY_RESET_V11')
BEGIN
    SET XACT_ABORT ON;
    BEGIN TRANSACTION;

    DELETE FROM monitor.BackupSample;
    DELETE FROM monitor.TlogBackupHistory;
    DELETE FROM monitor.RdsTaskHistory;
    DELETE FROM monitor.DatabaseLogSample;
    DELETE FROM monitor.DatabaseBackupPolicy;
    DELETE FROM monitor.DatabaseInventory;
    DELETE FROM monitor.AlertState WHERE category = N'BACKUP';
    DELETE FROM monitor.ReportState WHERE report_name = N'DAILY_HEALTH';

    INSERT monitor.DeploymentState
        (deployment_key, applied_utc, applied_by, details)
    VALUES
        (N'SYS_DATABASES_ONLY_RESET_V11', SYSUTCDATETIME(), SUSER_SNAME(),
         N'Cleared OPS.monitor database/backup history and switched inventory to visible sys.databases rows only.');

    COMMIT TRANSACTION;
END;
GO

